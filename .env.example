# Copy to .env.local for local development. Never commit real values.
# In production these live in Vercel → Project → Settings → Environment Variables.

# Public: safe in the browser. Row-level security limits what this key can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret: server only. Bypasses row-level security; used by the form routes after validation.
SUPABASE_SECRET_KEY=sb_secret_...

# Guest emails (Resend). Server only. Without it, the admin can preview but not send.
RESEND_API_KEY=re_...
EMAIL_FROM="Sobremesa Dinners <hola@sobremesadinners.com>"

# Vercel sends this to /api/cron/reminders so only the scheduler can trigger the morning reminder.
CRON_SECRET=a-long-random-string

# The address used in links inside emails. Defaults to the live domain; use localhost to test links locally.
NEXT_PUBLIC_SITE_URL=https://www.sobremesadinners.com
