# Copy to .env.local for local development. Never commit real values.
# In production these live in Vercel → Project → Settings → Environment Variables.

# Public: safe in the browser. Row-level security limits what this key can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret: server only. Bypasses row-level security; used by the form routes after validation.
SUPABASE_SECRET_KEY=sb_secret_...
